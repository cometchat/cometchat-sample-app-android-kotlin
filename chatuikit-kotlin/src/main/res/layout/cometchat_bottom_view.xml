<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Moderation indicator -->
    <LinearLayout
        android:id="@+id/moderation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cometchat_color_error_100"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/cometchat_padding_2"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/cometchat_2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cometchat_ic_warning" />

        <TextView
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/cometchat_moderation_block_message" />
    </LinearLayout>

    <!-- NOTE: The AI Assistant copy button lives in cometchat_ai_copy_button.xml and is
         rendered in the `ai_copy_view` slot OUTSIDE the bubble card so it does not inherit
         the bubble background. -->

</LinearLayout>
