<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_copy_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingTop="@dimen/cometchat_padding_1">

    <ImageView
        android:id="@+id/ai_copy_button"
        android:layout_width="@dimen/cometchat_20dp"
        android:layout_height="@dimen/cometchat_20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cometchat_copy"
        android:src="@drawable/cometchat_ic_copy_paste"
        app:tint="?attr/cometchatTextColorSecondary"
        tools:ignore="ContentDescription" />

</LinearLayout>
