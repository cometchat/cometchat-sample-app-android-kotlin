<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated row for the Saved Messages list. Visually mirrors a Conversations row (avatar, title,
  subtitle with sender prefix + message-type icon + preview, and a timestamp) but is a self-contained
  layout for the saved feature — it intentionally has no unread badge, receipt, or selection chrome.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/cometchat_padding_4"
    android:paddingTop="@dimen/cometchat_padding_3"
    android:paddingEnd="@dimen/cometchat_padding_4"
    android:paddingBottom="@dimen/cometchat_padding_3">

    <com.cometchat.uikit.kotlin.presentation.shared.baseelements.avatar.CometChatAvatar
        android:id="@+id/saved_item_avatar"
        android:layout_width="@dimen/cometchat_48dp"
        android:layout_height="@dimen/cometchat_48dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cometchat_margin_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/saved_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/cometchatTextAppearanceHeading4Medium"
            android:textColor="@color/cometchat_color_text_primary"
            tools:text="George Alan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cometchat_margin_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/saved_item_sender_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="?attr/cometchatTextAppearanceBodyRegular"
                android:textColor="@color/cometchat_color_text_secondary"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="John: "
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/saved_item_type_icon"
                android:layout_width="@dimen/cometchat_16dp"
                android:layout_height="@dimen/cometchat_16dp"
                android:layout_marginEnd="@dimen/cometchat_margin_1"
                android:contentDescription="@string/cometchat_message_type_icon"
                android:tint="@color/cometchat_color_text_secondary"
                android:visibility="gone"
                tools:src="@drawable/cometchat_ic_conversations_photo"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/saved_item_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/cometchatTextAppearanceBodyRegular"
                android:textColor="@color/cometchat_color_text_secondary"
                tools:text="Hey, let's catch up later!" />
        </LinearLayout>
    </LinearLayout>

    <com.cometchat.uikit.kotlin.presentation.shared.baseelements.date.CometChatDate
        android:id="@+id/saved_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/cometchat_margin_4"
        tools:text="4:30 PM" />
</LinearLayout>
