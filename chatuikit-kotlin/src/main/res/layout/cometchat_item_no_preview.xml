<?xml version="1.0" encoding="utf-8"?>
<!-- Viewer page for an attachment whose type can't be previewed (kind-mismatched item of a
     server-sent mixed payload). Google Drive-style: icon in a circle, "No preview available"
     title + subtitle, full-width Download button. Colors are bound at runtime from the theme
     (circle = neutral, button = primary). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/no_preview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/no_preview_icon_container"
                android:layout_width="96dp"
                android:layout_height="96dp">

                <ImageView
                    android:id="@+id/no_preview_icon"
                    android:layout_width="33dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cometchat_unsupported_file_icon" />
            </FrameLayout>

            <TextView
                android:id="@+id/no_preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/cometchat_no_preview_available"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/no_preview_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/cometchat_no_preview_subtitle"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/no_preview_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:id="@+id/no_preview_download_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/cometchat_download_icon" />

                    <TextView
                        android:id="@+id/no_preview_download_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cometchat_download"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
