<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/cometchat_padding_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/message_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_marginEnd="@dimen/cometchat_margin_6"
                android:maxLines="1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ic_thread_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/message_subtitle_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_subtitle_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_marginEnd="@dimen/cometchat_margin_6"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/video_view_container_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <LinearLayout
            android:id="@+id/parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/video_thumbnail"
                android:layout_width="@dimen/cometchat_70dp"
                android:layout_height="@dimen/cometchat_70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </LinearLayout>


        <FrameLayout
            android:id="@+id/play_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/play_btn_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/cometchat_play_background_icon" />

            <ImageView
                android:id="@+id/play_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/cometchat_play_icon" />

        </FrameLayout>

        <!-- Multi-attachment "+N" scrim over the (blurred) first frame; replaces the play badge
             when the message carries more than one attachment. Sized explicitly: FrameLayout only
             re-measures match_parent children when there is more than one, so a lone
             match_parent overlay in this wrap_content card would collapse to its text. -->
        <FrameLayout
            android:id="@+id/multi_attachment_overlay"
            android:layout_width="@dimen/cometchat_70dp"
            android:layout_height="@dimen/cometchat_70dp"
            android:background="#66000000"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_multi_attachment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
