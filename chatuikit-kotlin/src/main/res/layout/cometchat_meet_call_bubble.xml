<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:padding="@dimen/cometchat_padding_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/cometchat_padding_2"
        android:paddingBottom="@dimen/cometchat_padding_3">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/call_icon_card"
            android:layout_width="@dimen/cometchat_40dp"
            android:layout_height="@dimen/cometchat_40dp"
            app:cardCornerRadius="@dimen/cometchat_radius_max"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/call_icon"
                android:layout_width="@dimen/cometchat_20dp"
                android:layout_height="@dimen/cometchat_20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cometchat_margin_2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Time row: the timestamp keeps the start, the pin/save indicators sit at the END of
                 the bubble, mirroring the footer other bubbles get from the shared status-info view
                 (which the meet bubble hides because it draws its own timestamp). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cometchat_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subtitle_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/meet_pin_indicator"
                    android:layout_width="@dimen/cometchat_16dp"
                    android:layout_height="@dimen/cometchat_16dp"
                    android:layout_marginStart="@dimen/cometchat_margin_1"
                    android:contentDescription="@string/cometchat_pinned"
                    android:src="@drawable/cometchat_ic_pin_filled"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/meet_saved_indicator"
                    android:layout_width="@dimen/cometchat_16dp"
                    android:layout_height="@dimen/cometchat_16dp"
                    android:layout_marginStart="@dimen/cometchat_margin_1"
                    android:contentDescription="@string/cometchat_saved"
                    android:src="@drawable/cometchat_ic_saved_filled"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:id="@+id/join_call"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/cometchat_40dp">

        <TextView
            android:id="@+id/tv_join_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cometchat_join" />

    </LinearLayout>

</LinearLayout>
