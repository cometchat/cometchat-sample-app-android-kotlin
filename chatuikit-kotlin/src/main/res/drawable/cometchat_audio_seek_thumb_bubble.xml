<?xml version="1.0" encoding="utf-8"?>
<!-- Round knob for the message-list audio card's seek bar: 14dp white circle with a soft dark
     border so it stays visible on both the light incoming track and the white outgoing fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="14dp"
        android:height="14dp" />
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#1F000000" />
</shape>
