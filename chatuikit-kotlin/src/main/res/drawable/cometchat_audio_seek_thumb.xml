<?xml version="1.0" encoding="utf-8"?>
<!-- Round knob for the composer audio tile's seek bar: 10dp white circle with a light border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="10dp"
        android:height="10dp" />
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#E8E8E8" />
</shape>
