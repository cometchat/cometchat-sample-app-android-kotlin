<?xml version="1.0" encoding="utf-8"?>
<!--
    Thread Messages Activity Layout
    
    This layout contains the thread chat interface using CometChat UI Kit components:
    - CometChatThreadHeader: Shows parent message info
    - CometChatMessageList: Displays thread replies
    - CometChatMessageComposer: Allows composing thread replies
    
    Validates: Requirements 6.9
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.messages.ThreadMessagesActivity">

    <!-- Toolbar for back navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/thread">

        <!-- Thread subscription (mute/unmute) bell — hidden until the feature gate allows it -->
        <ImageView
            android:id="@+id/iv_thread_subscription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:padding="@dimen/cometchat_padding_2"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerInside"
            android:contentDescription="@string/cometchat_thread_unmute"
            android:src="@drawable/cometchat_ic_notifications_off"
            android:visibility="gone"
            app:tint="?attr/cometchatIconTintPrimary" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Thread Header - shows parent message -->
    <com.cometchat.uikit.kotlin.presentation.threadheader.ui.CometChatThreadHeader
        android:id="@+id/threadHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Message List - displays thread replies -->
    <com.cometchat.uikit.kotlin.presentation.messagelist.ui.CometChatMessageList
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Message Composer - for composing thread replies -->
    <com.cometchat.uikit.kotlin.presentation.messagecomposer.ui.CometChatMessageComposer
        android:id="@+id/messageComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
