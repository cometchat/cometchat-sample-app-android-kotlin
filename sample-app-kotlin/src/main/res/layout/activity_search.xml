<?xml version="1.0" encoding="utf-8"?>
<!--
    Search Activity Layout
    
    This layout contains the CometChatSearch component for global and contextual
    search across conversations and messages.
    
    Features:
    - Search bar with back, clear, and search icons
    - Filter chips for Photos, Videos, Documents, Links, Audio, Groups, Unread
    - Conversation search results with avatar, title, subtitle, timestamp
    - Message search results with type-specific content display
    - Sticky date headers for message results
    - Loading, empty, error, and initial state views
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cometchatBackgroundColor1"
    tools:context=".ui.search.SearchActivity">

    <com.cometchat.uikit.kotlin.presentation.search.ui.CometChatSearch
        android:id="@+id/search_component"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
