  "engines": {
    "node": ">=18"
  },
  "license": "Private",
  "scripts": {
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "postinstall": "jetify",
    "validate": "npm ls",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && react-native start",
    "build": "webpack --mode production",
    "ios": "react-native run-ios",
    "android": "react-native run-android --main-activity .separation.MainActivity",
    "format": "prettier --write './src/**/*.{ts,tsx}'",
    "prepare": "husky install",
    "bundlew": "cd android && sh create-artifacts.sh",
    "bundle": "cd android && ./create-artifacts.sh",
    "bundle-ios": "export NODE_OPTIONS=--openssl-legacy-provider && npx react-native bundle --entry-file='index.android.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios' --assets-dest='./ios'",
    "bundle-android": "export NODE_OPTIONS=--openssl-legacy-provider && npx react-native bundle --entry-file='index.android.js' --bundle-output='./android/CometChatCallSDK/src/main/assets/cometchat.android.bundle' --sourcemap-output='./android/CometChatCallSDK/src/main/assets/cometchat.android.map' --dev=false --platform='android' --assets-dest='./android/CometChatCallSDK/src/main/res/'",
    "generate-xcframework": "./generate-xcframework.sh",
    "dev": "rm -rf android/CometChatCallSDK/src/main/assets/* && npm start"
  },
  "browser": {
    "jQuery-Impromptu": "jQuery-Impromptu/src/jquery-impromptu.js"
  }
}
